---
/**
 * DynNum — inline number baked from the homelab stats at build time.
 *
 * The real value is fetched once per build (see lib/build-stats) and rendered
 * straight into the static HTML — no client fetch, no fallback "flash". CI rebuilds
 * daily, so the number stays fresh. If the build couldn't reach /api/stats, the
 * FALLBACK snapshot of lib/build-stats is used instead.
 *
 * The `fallback` prop is only read when the key is missing from BOTH the KV and that
 * snapshot (statValue). Since every displayed key is in the snapshot (2026-10-16),
 * these props never render: a stale `fallback="60"` found by grep is not a drift.
 * Keep stale numbers fixed in build-stats.ts only, not prop by prop.
 *
 * Usage:
 *   <DynNum stat="lxc_count" fallback="53+" suffix="+" />
 *
 * The rendered span carries `data-stat` so the number stays identifiable in the
 * SERVED html. It is not styling and no script reads it — it exists so
 * scripts/check-deployed.mjs can compare what production actually serves against
 * the live KV, key by key. Without it a baked number is an anonymous <span>, and
 * the only way to audit production is a per-value prose regex — the approach that
 * already failed twice (a regex matches the first occurrence only, so a file can
 * hold a second stale literal and the guard still goes green). See issue #136.
 */
import { statValue } from '../lib/build-stats';
import { getLangFromUrl, formatNumber } from '../i18n/utils';

interface Props {
  stat: string;
  fallback: string;
  suffix?: string;
  // Séparateur de milliers dans la langue de la PAGE (2,068,833 · 2 068 833).
  // Opt-in : une valeur non numérique ou un fallback comme « 2700+ » passe tel quel.
  group?: boolean;
}

const { stat, fallback, suffix = '', group = false } = Astro.props;
const raw = await statValue(stat, fallback, suffix);
const n = Number(raw.slice(0, raw.length - suffix.length));
const display = group && Number.isFinite(n) ? `${formatNumber(n, getLangFromUrl(Astro.url))}${suffix}` : raw;
---
<span data-stat={stat}>{display}</span>
