---
/**
 * CrossLink — le bloc de renvoi vers une autre page : un titre, une phrase,
 * une flèche. Il était recopié dans about, ctf, securite (EN et FR) et dans
 * styles/projets.css. Voir pixelium-site#237, lot 4.
 *
 * - `href`    : la page visée.
 * - `title`   : le titre du bloc, pictogramme compris.
 * - `compact` : la version resserrée de /about, où deux blocs tiennent côte à côte.
 * - slot par défaut : la phrase (texte, <DynNum />…).
 *
 * Le survol (`.crosslink-block:hover`) et la grille `.crosslink-duo` restent
 * dans styles/page-chrome.css. La section qui entoure le bloc, et sa marge,
 * restent dans la page.
 */
interface Props {
  href: string;
  title: string;
  compact?: boolean;
}

const { href, title, compact = false } = Astro.props;
---

<a href={href} class:list={['crosslink-block', { compact }]}>
  <div>
    <h3>{title}</h3>
    <p><slot /></p>
  </div>
  <span class="crosslink-arrow">&#8594;</span>
</a>

<style>
  .crosslink-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.5rem 2rem;
    border: 1px solid rgb(var(--accent-rgb) / 0.2);
    border-radius: 8px;
    background: linear-gradient(135deg, rgb(var(--accent-rgb) / 0.05), rgb(var(--accent-rgb) / 0.02));
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  h3 {
    font-size: var(--text-lg);
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  p {
    font-size: var(--text-md);
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .crosslink-arrow {
    font-size: var(--text-4xl);
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .compact {
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
  }

  .compact h3 {
    margin-bottom: 0.3rem;
  }

  .compact p {
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .compact .crosslink-arrow {
    font-size: var(--text-2xl);
  }

  @media (max-width: 640px) {
    .crosslink-block {
      flex-direction: column;
      gap: 1rem;
      padding: 1.25rem;
    }

    p {
      font-size: var(--text-sm);
    }

    .compact {
      gap: 0.75rem;
      padding: 1rem;
    }
  }
</style>
