<script>
  function initInception() {
    const overlay = document.getElementById('inception');
    const trigger = document.getElementById('inceptionOpen');
    if (!overlay || !trigger || overlay.dataset.init) return;
    overlay.dataset.init = '1';
    const open = () => { overlay.classList.add('open'); (overlay.querySelector('.inception-close') as HTMLElement)?.focus(); };
    const close = () => overlay.classList.remove('open');
    trigger.addEventListener('click', open);
    overlay.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === overlay || t.classList.contains('inception-close')) close();
    });
  }
  // Escape-to-close bound once at document scope — query the live overlay each
  // time so navigations (astro:page-load) don't re-add the listener and leak the
  // previous one (which captured a now-detached overlay).
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const ov = document.getElementById('inception');
    if (ov?.classList.contains('open')) ov.classList.remove('open');
  });
  initInception();
  document.addEventListener('astro:page-load', initInception);
</script>
