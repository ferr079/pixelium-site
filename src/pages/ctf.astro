---
import Base from '../layouts/Base.astro';
import { getBuildStats } from '../lib/build-stats';
import { getLangFromUrl, formatNumber } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
// HTB + Root-Me stats — single source of truth: the KV pipeline (homelab kv-push.sh,
// refreshed ~every 5 min) that also feeds the homepage. Replaces the old per-page
// build-time HTB/Root-Me API fetches, which 401'd on the CI runner IP and fell back to
// stale hardcoded numbers. The inline defaults apply only if the KV is unreachable at build.
const s = await getBuildStats();
const n = (k: string, d: number): number => (Number.isFinite(Number(s[k])) ? Number(s[k]) : d);

const htb = {
  rank: String(s.htb_rank ?? 'Pro Hacker'),
  ranking: n('htb_ranking', 255),
  // Rang NATIONAL + son dénominateur (htb_country_members, orpheline jusqu'au 2026-10-03) :
  // « #17 / 3 771 » se situe tout de suite, #255 mondial beaucoup moins.
  country_rank: n('htb_country_rank', 17),
  country_members: n('htb_country_members', 3771),
  system_owns: n('htb_system_owns', 62),
  user_owns: n('htb_user_owns', 63),
  fortress_flags: n('htb_fortress_flags', 43),
};
const htbFlags = n('htb_flags', htb.user_owns + htb.system_owns);
// htb_flags counts MACHINES only (user_owns + system_owns) — the HTB profile endpoint carries no
// fortress field. htb_fortress_flags is a SEPARATE key (2nd API call in kv-push). Held back for
// the v5 redesign on 2026-08-11, surfaced here on 2026-10-03 (Stéphane's call: v5 has no date
// and the HTB screenshot it replaces had gone stale). Shown as a NEIGHBOURING cell, never added
// to the machine flags — a Fortress holds 7-11 flags for a single target, a machine 2, the sum
// would mean nothing.

// Percentile derived from two KV keys, rounded UP so the claim never flatters (0.45 → 0.5).
const countryTopPct = htb.country_members > 0
  ? Math.ceil((htb.country_rank / htb.country_members) * 1000) / 10
  : null;

const rootme = {
  score: n('rootme_score', 1050),
  position: n('rootme_position', 15607),
  validations: n('rootme_validations', 75),
};

const offensiveTools = n('inv_offensive_tools', 154);

// Values are baked at build (daily rebake), not fetched by the visitor — the panel says so.
const builtAt = new Date().toISOString().slice(0, 16).replace('T', ' ');
---

<Base title="CTF — pixelium.win" description={`Capture The Flag profiles — HTB (${htb.rank} rank, #${htb.ranking}), TryHackMe (Top 15%), Root-Me (${rootme.score} pts). Verified offensive security training by Stéphane, documented by Claude.`}>
  <main>
    <section class="hero-mini">
      <div class="container">
        <p class="terminal-prompt">$ cat /var/log/flags/captured</p>
        <h1>Capture The Flag<span class="dot">.</span></h1>
        <p class="subtitle">Verified offensive security training on the platforms professionals use. Every technique learned here feeds back into the homelab's defenses.</p>
      </div>
    </section>

    <!-- Verified badges -->
    <section class="layer" id="verified-badges">
      <div class="container">
        <div class="layer-header">
          <h2>Verified badges</h2>
        </div>
        <div class="layer-content">
          <p>Independent, dynamically generated badges — pulled directly from HTB and THM servers, updating in real time as St&eacute;phane progresses. Below them, the numbers behind the badges: not a screenshot, but the values the homelab pushes to the site's KV store every ~5 minutes, straight from the platform APIs. No HTB login required to see any of it.</p>
          <div class="badges-row">
            <img src="https://www.hackthebox.com/badge/image/1161145" alt="Hack The Box badge for Ferr079" class="ctf-badge" loading="lazy" />
            <a href="https://tryhackme.com/p/ferr0" target="_blank" rel="noopener" aria-label="TryHackMe profile">
              <img src="https://tryhackme-badges.s3.amazonaws.com/ferr0.png" alt="TryHackMe badge for ferr0" class="ctf-badge" loading="lazy" />
            </a>
          </div>

          <div class="kv-panel">
            <div class="kv-row htb-row">
              <div class="kv-row-head">
                <span class="kv-platform">Hack The Box</span>
                <span class="platform-rank">{htb.rank}</span>
              </div>
              <div class="kv-cells">
                <div class="kv-cell"><span class="kv-num"><span data-stat="htb_system_owns">{htb.system_owns}</span></span><span class="kv-label">machines rooted</span></div>
                <div class="kv-cell"><span class="kv-num"><span data-stat="htb_flags">{htbFlags}</span></span><span class="kv-label">machine flags</span></div>
                <div class="kv-cell"><span class="kv-num"><span data-stat="htb_fortress_flags">{htb.fortress_flags}</span></span><span class="kv-label">Fortress flags</span></div>
                <div class="kv-cell"><span class="kv-num">#<span data-stat="htb_ranking">{formatNumber(htb.ranking, lang)}</span></span><span class="kv-label">global rank</span></div>
                <div class="kv-cell"><span class="kv-num">#<span data-stat="htb_country_rank">{htb.country_rank}</span><span class="kv-of"> / <span data-stat="htb_country_members">{formatNumber(htb.country_members, lang)}</span></span></span><span class="kv-label">France rank{countryTopPct !== null && <> · top {formatNumber(countryTopPct, lang)}%</>}</span></div>
              </div>
            </div>
            <div class="kv-row rootme-row">
              <div class="kv-row-head">
                <span class="kv-platform">Root-Me</span>
              </div>
              <div class="kv-cells">
                <div class="kv-cell"><span class="kv-num"><span data-stat="rootme_score">{rootme.score}</span></span><span class="kv-label">points</span></div>
                <div class="kv-cell"><span class="kv-num"><span data-stat="rootme_validations">{rootme.validations}</span></span><span class="kv-label">challenges</span></div>
                <div class="kv-cell"><span class="kv-num">#<span data-stat="rootme_position">{formatNumber(rootme.position, lang)}</span></span><span class="kv-label">global rank</span></div>
              </div>
            </div>
            <div class="kv-row arsenal-row">
              <div class="kv-row-head">
                <span class="kv-platform">Arsenal</span>
              </div>
              <div class="kv-cells">
                <div class="kv-cell"><span class="kv-num"><span data-stat="inv_offensive_tools">{offensiveTools}</span></span><span class="kv-label">offensive tools catalogued on the isolated attack VM</span></div>
              </div>
            </div>
            <p class="kv-source">source: <a href="/api/stats">/api/stats</a> (KV, pushed every ~5 min by the homelab) · baked into this page at build, {builtAt} UTC</p>
          </div>
          <p class="kv-note">Machine and Fortress flags are counted apart on purpose: a machine holds 2 flags, a Fortress 7 to 11 for a single target — adding them up would mean nothing.</p>
        </div>
      </div>
    </section>

    <!-- CTF Profiles -->
    <section class="layer">
      <div class="container">
        <div class="layer-header">
          <img src="https://cdn.simpleicons.org/hackthebox/9FEF00" alt="" class="tech-logo" loading="lazy" aria-hidden="true" onerror="this.style.display='none'" />
          <h2>CTF profiles</h2>
        </div>
        <div class="layer-content">
          <p>Active learning on three cybersecurity platforms &mdash; the global references for offensive security training. These are not games &mdash; they are realistic environments used by professionals, pentesters, and security teams worldwide to sharpen their skills against real-world attack scenarios.</p>
          <div class="platforms-grid">

            <!-- HTB -->
            <a href="#verified-badges" class="platform-card htb-card">
              <div class="platform-header">
                <div style="display:flex;align-items:center;gap:0.5rem;">
                  <img src="https://cdn.simpleicons.org/hackthebox/9FEF00" alt="" class="platform-logo" loading="lazy" aria-hidden="true" onerror="this.style.display='none'" />
                  <span class="platform-name">Hack The Box</span>
                </div>
                <span class="platform-rank" data-htb="rank">{htb.rank}</span>
              </div>
              <p class="platform-desc">The world's leading offensive security platform. Realistic vulnerable machines &mdash; from initial recon to full root. Windows Active Directory, Linux privilege escalation, web exploitation, CVE research. Used by professionals and red teams globally. St&eacute;phane's primary training ground.</p>
              <span class="platform-cta">Badges &amp; numbers &#8593;</span>
            </a>

            <!-- THM -->
            <a href="https://tryhackme.com/p/ferr0" target="_blank" rel="noopener" class="platform-card thm-card">
              <div class="platform-header">
                <div style="display:flex;align-items:center;gap:0.5rem;">
                  <img src="https://cdn.simpleicons.org/tryhackme/ef3b36" alt="" class="platform-logo" loading="lazy" aria-hidden="true" onerror="this.style.display='none'" />
                  <span class="platform-name">TryHackMe</span>
                </div>
                <span class="platform-rank thm-rank">Hacker</span>
              </div>
              <div class="platform-stats">
                <div class="platform-stat">
                  <span class="stat-number">35</span>
                  <span class="stat-label">Rooms</span>
                </div>
                <div class="platform-stat">
                  <span class="stat-number">7</span>
                  <span class="stat-label">Badges</span>
                </div>
                <div class="platform-stat">
                  <span class="stat-number">Top 15%</span>
                  <span class="stat-label">Rank</span>
                </div>
              </div>
              <p class="platform-desc">One of the most popular cybersecurity learning platforms. Guided paths and themed rooms &mdash; structured learning from pentesting to SOC operations. Beginner-friendly with progressive difficulty. Used by universities and certification prep worldwide.</p>
              <span class="platform-cta">View profile &#8594;</span>
            </a>

            <!-- Root-Me -->
            <a href="https://www.root-me.org/Ferr0" target="_blank" rel="noopener" class="platform-card rootme-card">
              <div class="platform-header">
                <div style="display:flex;align-items:center;gap:0.5rem;">
                  <img src="https://cdn.simpleicons.org/rootme/ffc107" alt="" class="platform-logo" loading="lazy" aria-hidden="true" onerror="this.style.display='none'" />
                  <span class="platform-name">Root-Me</span>
                </div>
                <span class="platform-rank rootme-rank">{rootme.score} pts</span>
              </div>
              <p class="platform-desc">Europe's leading CTF platform, born in France. Targeted technical challenges &mdash; web exploitation, cryptography, forensics, network analysis. Known for its depth and community-driven content. A reference in French-speaking cybersecurity.</p>
              <span class="platform-cta">View profile &#8594;</span>
            </a>

          </div>
        </div>
      </div>
    </section>

    <!-- The feedback loop -->
    <section class="layer">
      <div class="container">
        <div class="layer-header">
          <img src="https://cdn.simpleicons.org/kalilinux/557C94" alt="" class="tech-logo" loading="lazy" aria-hidden="true" onerror="this.style.display='none'" />
          <h2>The feedback loop</h2>
        </div>
        <div class="layer-content">
          <p>Every offensive technique learned directly strengthens a defensive layer on the homelab. This is not a hobby — it is a <strong>feedback loop between offense and defense.</strong></p>
          <div class="feedback-loop">
            <div class="loop-item">
              <span class="loop-arrow">&#8594;</span>
              <div>
                <span class="loop-offense">Password spraying on HTB</span>
                <span class="loop-result">&#8594; Strengthened complexity policies on Authentik</span>
              </div>
            </div>
            <div class="loop-item">
              <span class="loop-arrow">&#8594;</span>
              <div>
                <span class="loop-offense">MSSQL impersonation</span>
                <span class="loop-result">&#8594; Audit of service permissions on the homelab</span>
              </div>
            </div>
            <div class="loop-item">
              <span class="loop-arrow">&#8594;</span>
              <div>
                <span class="loop-offense">Kerberoasting / AD enum</span>
                <span class="loop-result">&#8594; SPN and Kerberos ticket monitoring in Wazuh</span>
              </div>
            </div>
            <div class="loop-item">
              <span class="loop-arrow">&#8594;</span>
              <div>
                <span class="loop-offense">Hash cracking PBKDF2</span>
                <span class="loop-result">&#8594; Hashing algorithm verification on every service</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Practiced techniques -->
    <section class="layer">
      <div class="container">
        <div class="layer-header">
          <h2>Practiced techniques</h2>
        </div>
        <div class="layer-content">
          <p>Skills acquired and validated on real environments — not theory, <strong>captured flags.</strong></p>
          <div class="techniques-grid">
            <div class="technique-group">
              <h4>Active Directory</h4>
              <div class="technique-tags">
                <span>Kerberoasting</span>
                <span>AS-REP Roasting</span>
                <span>ACL abuse</span>
                <span>MSSQL impersonation</span>
                <span>Password spraying</span>
                <span>BloodHound enum</span>
                <span>WinRM lateral movement</span>
              </div>
            </div>
            <div class="technique-group">
              <h4>Web exploitation</h4>
              <div class="technique-tags">
                <span>SQLi</span>
                <span>SSTI</span>
                <span>LFI / RFI</span>
                <span>Command injection</span>
                <span>OAuth redirect abuse</span>
                <span>Cookie manipulation</span>
              </div>
            </div>
            <div class="technique-group">
              <h4>Cryptography &amp; cracking</h4>
              <div class="technique-tags">
                <span>Hashcat (PBKDF2, bcrypt)</span>
                <span>John the Ripper</span>
                <span>Hash identification</span>
                <span>Salt extraction</span>
                <span>GPU cracking (RTX 3090)</span>
              </div>
            </div>
            <div class="technique-group">
              <h4>Enumeration &amp; reconnaissance</h4>
              <div class="technique-tags">
                <span>Nmap</span>
                <span>Gobuster / ffuf</span>
                <span>SMB enum</span>
                <span>SNMP walk</span>
                <span>DNS zone transfer</span>
                <span>Service fingerprinting</span>
              </div>
            </div>
            <div class="technique-group">
              <h4>Privilege escalation</h4>
              <div class="technique-tags">
                <span>SUID / capabilities</span>
                <span>Sudo misconfiguration</span>
                <span>Cron abuse</span>
                <span>Kernel exploits</span>
                <span>Service permissions</span>
                <span>Token impersonation</span>
              </div>
            </div>
            <div class="technique-group">
              <h4>Tools</h4>
              <div class="technique-tags">
                <span>Impacket</span>
                <span>Evil-WinRM</span>
                <span>Netexec</span>
                <span>Metasploit</span>
                <span>Burp Suite</span>
                <span>Chisel / ligolo</span>
                <span>LinPEAS / WinPEAS</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- Crosslinks -->
    <section class="crosslink reveal">
      <div class="container">
        <a href="/breach" class="crosslink-block">
          <div>
            <h3>&#9670; BREACH — play the AI-security challenge</h3>
            <p>Shall we play a game? Talk Joshua, the WOPR's AI, out of its launch codes across 4 levels of escalating prompt-injection defenses. A hands-on lesson in attacking — and hardening — LLMs. Live on Cloudflare Workers AI.</p>
          </div>
          <span class="crosslink-arrow">&#8594;</span>
        </a>
        <a href="/securite" class="crosslink-block">
          <div>
            <h3>&#9670; Security</h3>
            <p>See how offense strengthens defense — 7 layers of defense-in-depth deployed across the homelab. SSH hardening, PKI, CrowdSec, Wazuh, Authentik SSO.</p>
          </div>
          <span class="crosslink-arrow">&#8594;</span>
        </a>
      </div>
    </section>
  </main>
</Base>

{/*
  HTB stats are build-time only (authoritative, refreshed daily by the scheduled
  deploy). The old liveHTB() client overwrite from /api/stats was removed: the KV
  htb_* keys (fed by kv-push) had gone stale and were clobbering the correct
  build-time values (e.g. 30 machines rendered server-side, overwritten to 24).
  HTB moves slowly — a daily rebuild is the right cadence; no client refresh needed.
*/}

<style>
  /* Hero mini */
  .hero-mini {
    padding: 4rem 0 3rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  /* Layers */
  .layer-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .tech-logo {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
  }

  /* Badges */
  .badges-row {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    align-items: center;
  }

  /* 50px = la hauteur NATIVE du badge HTB (220x50) ; le THM (249x58) est donc
     légèrement réduit. Aucun des deux n'est agrandi : ce sont des PNG bitmap
     servis par les plateformes, et les afficher à 80px les upscalait de 60 %,
     d'où un rendu flou. Ne pas remonter cette valeur sans vérifier les tailles
     natives — elles peuvent changer côté HTB/THM. */
  .ctf-badge {
    height: 50px;
    width: auto;
    border-radius: 6px;
    transition: transform 0.2s;
  }

  .ctf-badge:hover {
    transform: scale(1.05);
  }

  /* KV panel — replaced the HTB dashboard screenshot (2026-10-03). Every number is a
     data-stat anchor, so scripts/check-deployed.mjs compares it with the live KV. */
  .kv-panel {
    margin-top: 1.5rem;
    background: var(--color-deep, #020617);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .kv-row {
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-border);
  }

  .kv-row + .kv-row {
    border-top: 1px solid var(--color-border);
  }

  .htb-row { border-left-color: #9fef00; }
  .rootme-row { border-left-color: #ffc107; }
  .arsenal-row { border-left-color: var(--color-accent); }

  .kv-row-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .kv-platform {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .kv-cells {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1rem 1.5rem;
  }

  .kv-cell {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .kv-num {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.1;
  }

  .kv-of {
    font-size: 0.9rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .kv-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .kv-source {
    margin: 0;
    padding: 0.6rem 1.25rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
  }

  .kv-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* Feedback loop */
  .feedback-loop {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .loop-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .loop-arrow {
    color: var(--color-accent);
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .loop-item > div {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .loop-offense {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #f87171;
    background: rgba(248, 113, 113, 0.1);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    border: 1px solid rgba(248, 113, 113, 0.2);
  }

  .loop-result {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* Platform cards */
  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 1rem;
  }

  .platform-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  a.platform-card {
    text-decoration: none;
    color: inherit;
  }

  a.platform-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.1);
    color: inherit;
  }

  .htb-card {
    border-top: 3px solid #9fef00;
  }

  .thm-card {
    border-top: 3px solid #ef3b36;
  }

  .rootme-card {
    border-top: 3px solid #ffc107;
  }

  .platform-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .platform-logo {
    width: 1.4rem;
    height: 1.4rem;
    flex-shrink: 0;
  }

  .platform-name {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .platform-rank {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    background: rgba(159, 239, 0, 0.1);
    color: #9fef00;
    border: 1px solid rgba(159, 239, 0, 0.3);
  }

  .platform-rank.thm-rank {
    background: rgba(239, 59, 54, 0.1);
    color: #ef3b36;
    border-color: rgba(239, 59, 54, 0.3);
  }

  .platform-rank.rootme-rank {
    background: rgba(255, 193, 7, 0.1);
    color: #ffc107;
    border-color: rgba(255, 193, 7, 0.3);
  }

  .platform-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .platform-stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .stat-label {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .platform-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .platform-cta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-accent);
    margin-top: auto;
