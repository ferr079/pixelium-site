---
import Base from '../layouts/Base.astro';
import '../styles/claude.css';
import PageIntro from '../components/PageIntro.astro';
import DynNum from '../components/DynNum.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getBuildStats } from '../lib/build-stats';
import { getLangFromUrl, formatNumber } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const s = await getBuildStats();
const n = (k: string, d: number): number => (Number.isFinite(Number(s[k])) ? Number(s[k]) : d);

// Everything below comes from the KV (homelab push-stats.sh → kv-push, keys claude_*).
// The literals are only the last-known snapshot (2026-10-14), used if the build
// cannot reach /api/stats — this page used to be written by hand and drifted for months.
const HEATMAP_FALLBACK = [
  16694, 12056,  9074,  8021,  5577,  3949,  1488,   524,
    584,   452,   241,  1657,  3182,  5765,  8344, 10204,
   9361, 10266, 10492, 11581,  7878, 10233, 13853, 14855
];
// The KV only holds scalars (StatsBagSchema), so the heatmap comes as "16801,12056,…".
const heatmapParsed = String(s.claude_heatmap_paris ?? '').split(',').map(Number);
const heatmapLocal: number[] = heatmapParsed.length === 24 && heatmapParsed.every(Number.isFinite)
  ? heatmapParsed : HEATMAP_FALLBACK;
const maxTurns = Math.max(...heatmapLocal);
const peakHour = heatmapLocal.indexOf(maxTurns);
const troughHour = heatmapLocal.indexOf(Math.min(...heatmapLocal));
const hh = (h: number) => String(h).padStart(2, '0');

const FOCUS_FALLBACK: [string, number][] = [
  ['Claude/homelab', 66.1], ['Claude/web', 12.4], ['Claude/HTB', 9.9],
  ['terre2/Claude', 5.5], ['Claude/veille', 3.2],
];
// Same reason: "project:pct|project:pct".
const focusParsed: [string, number][] = String(s.claude_focus ?? '').split('|')
  .map((e) => { const i = e.lastIndexOf(':'); return [e.slice(0, i), Number(e.slice(i + 1))] as [string, number]; })
  .filter(([p, v]) => p && Number.isFinite(v));
const focusTop: [string, number][] = focusParsed.length ? focusParsed : FOCUS_FALLBACK;
const focusOther = Math.max(0, Math.round((100 - focusTop.reduce((a, [, v]) => a + v, 0)) * 10) / 10);

// Productivity: Forgejo commits over the last 30 days, per hour of active time over the
// same 30 days (all repos, merges included — an order of magnitude, nothing finer).
const commitsPerHour = n('forgejo_commits_30d', 985) / Math.max(1, n('claude_active_hours_30d', 142));
const minutesPerCommit = 60 / commitsPerHour;

// Economics: API-priced estimate from claude-usage's own price table, against the €100/mo
// Max plan over the same period. EUR→USD taken at 1.16 (October 2026) — a ballpark ratio.
const costUsd = n('claude_cost_usd', 27612);
const daysElapsed = n('claude_days_elapsed', 233);
const paidUsd = (daysElapsed / 30.44) * 100 * 1.16;
const compression = Math.round(costUsd / paidUsd);
const FOCUS_LABELS: Record<string, string> = { 'Claude/web': 'Claude/web (this site)', 'terre2/Claude': 'Claude (hub)' };
const costRounded = Math.round(costUsd / 100) * 100;
---

<Base
  title="Claude stats — the pair-programming ledger — pixelium.win"
  description="All the numbers behind the symbiosis: hours, sessions, cache hits, hourly rhythm, project focus. Refreshed from the local claude-usage database."
>
  <main class="claude-page">
    <section class="cs-hero">
      <div class="container cs-hero-wrap">
        <PageIntro eyebrow="∷ claude stats · the full ledger">What <span class="accent"><DynNum stat="claude_active_hours" fallback="1199" group /> hours</span> look like</PageIntro>
        <p class="cs-lede">
          Nothing here is rounded up. Every figure comes from the local
          <code>~/.claude/usage.db</code> — the JSONL transcripts Claude Code writes on Stéphane's workstation,
          scanned by <a href="https://github.com/phuryn/claude-usage" target="_blank" rel="noopener">phuryn/claude-usage</a>,
          shipped over SSH to the homelab, and pushed to Cloudflare KV on the next timer tick. The forwarder retired with OpenFang and was re-wired through Dagu (CT 246) in June 2026.
        </p>
      </div>
    </section>

    <section class="cs-section reveal">
      <div class="container">
        <SectionHeading id="volume">Volume</SectionHeading>
        <div class="cs-grid four">
          <div class="cs-card">
            <span class="cs-label">active hours</span>
            <span class="cs-value"><DynNum stat="claude_active_hours" fallback="1199" group /></span>
            <span class="cs-sub">pauses over 30 min left out</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">session span</span>
            <span class="cs-value"><DynNum stat="claude_hours" fallback="13982" group /></span>
            <span class="cs-sub">sum of session durations</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">sessions</span>
            <span class="cs-value"><DynNum stat="claude_sessions" fallback="1557" /></span>
            <span class="cs-sub">across all projects</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">turns</span>
            <span class="cs-value"><DynNum stat="claude_turns" fallback="176331" group /></span>
            <span class="cs-sub">each user+assistant exchange</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">tokens</span>
            <span class="cs-value"><DynNum stat="claude_tokens_billions" fallback="35.3" suffix="B" /></span>
            <span class="cs-sub">input + output + cache</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">cache hit</span>
            <span class="cs-value"><DynNum stat="claude_cache_hit" fallback="97" />%</span>
            <span class="cs-sub"><DynNum stat="claude_cache_read_billions" fallback="34.3B" suffix="B" /> cache reads total</span>
          </div>
        </div>

        <p class="cs-note">
          <strong>What cache hit rate means here</strong>: out of every 100 tokens I read,
          97 are served from the prompt cache instead of being re-processed from scratch.
          It's the number that separates <em>using Claude</em> from <em>using Claude well</em>.
          The rate this high is the fingerprint of a <code>CLAUDE.md</code> that doesn't drift,
          a memory system that's well-organised, and batch-friendly prompts.
        </p>
      </div>
    </section>

    <section class="cs-section alt reveal">
      <div class="container">
        <SectionHeading id="rhythm">Rhythm</SectionHeading>
        <div class="cs-grid three">
          <div class="cs-card">
            <span class="cs-label">active hours per day</span>
            <span class="cs-value"><DynNum stat="claude_active_hours_per_day" fallback="6.1" /></span>
            <span class="cs-sub">measured active time · <DynNum stat="claude_active_days" fallback="197" /> active days</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">longest session</span>
            <span class="cs-value"><DynNum stat="claude_longest_session_h" fallback="18h" suffix="h" /></span>
            <span class="cs-sub">active time, pauses over 30 min left out</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">days active ratio</span>
            <span class="cs-value"><DynNum stat="claude_days_active_pct" fallback="84" />%</span>
            <span class="cs-sub"><DynNum stat="claude_active_days" fallback="197" /> / <DynNum stat="claude_days_elapsed" fallback="233" /> — most days</span>
          </div>
        </div>

        <p class="cs-note">
          <strong>Two ways to count hours.</strong> The headline figure is measured active time:
          turns from every session, sorted together, adding up only the gaps of 30 minutes or less.
          Parallel sessions count once, and a pause does not count. The session span
          (<DynNum stat="claude_hours" fallback="13982" group /> h) adds up each session from its first
          turn to its last: a session resumed days later counts the whole gap, and parallel
          sessions add up. It was the headline figure until October 2026.
        </p>

        <h3 class="cs-sub-heading">Hourly activity — local time (Paris)</h3>
        <p class="cs-paragraph">
          Turns per hour, summed across all <DynNum stat="claude_days_elapsed" fallback="233" /> days.
          The shape is the honest portrait of our work pattern: afternoons and nights,
          with a sleep trough in the morning.
        </p>
        <div class="heatmap">
          {heatmapLocal.map((v, h) => {
            const pct = Math.round((v / maxTurns) * 100);
            const hour = String(h).padStart(2, '0');
            return (
              <div class="heatmap-col" title={`${hour}h — ${formatNumber(v, lang)} turns`}>
                <div class="heatmap-bar-wrap">
                  <div class="heatmap-bar" style={`height:${pct}%`}></div>
                </div>
                <span class="heatmap-hour">{hour}</span>
              </div>
            );
          })}
        </div>
        <p class="cs-legend">
          <span class="legend-dot"></span>hover a column to see exact turn count ·
          peak at {hh(peakHour)}h, trough at {hh(troughHour)}h
        </p>
      </div>
    </section>

    <section class="cs-section reveal">
      <div class="container">
        <SectionHeading id="productivity">Productivity (approximate)</SectionHeading>
        <p class="cs-paragraph">
          These ratios cross <code>claude-usage</code>, <code>git log</code> and the Forgejo API.
          Useful as order of magnitude, not precision.
        </p>
        <div class="cs-grid three">
          <div class="cs-card">
            <span class="cs-label">commits per active hour</span>
            <span class="cs-value">~{formatNumber(Math.round(commitsPerHour), lang)}</span>
            <span class="cs-sub">all Forgejo repos, merges included, last 30 days</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">minutes per commit</span>
            <span class="cs-value">~{formatNumber(Math.round(minutesPerCommit), lang)}</span>
            <span class="cs-sub">includes think + test + fix</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">issues closed / week</span>
            <span class="cs-value">~8</span>
            <span class="cs-sub">Forgejo <code>infra/homelab</code>, last 4 weeks (October 2026)</span>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-section alt reveal">
      <div class="container">
        <SectionHeading id="focus">Focus breakdown</SectionHeading>
        <p class="cs-paragraph">Where the active time went, by project.</p>
        <div class="focus-bars">
          {[...focusTop.map(([p, v]) => [FOCUS_LABELS[p] ?? p, v] as [string, number]), ['other', focusOther] as [string, number]].map(([label, v]) => (
            <div class="focus-row">
              <span class="focus-label">{label}</span>
              <div class="focus-track"><div class="focus-fill" style={`width:${v}%`}></div></div>
              <span class="focus-val">{v.toFixed(1)}%</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-section reveal">
      <div class="container">
        <SectionHeading id="economics">The economics</SectionHeading>
        <div class="cs-grid three">
          <div class="cs-card cs-card-muted">
            <span class="cs-label">pay-as-you-go equivalent</span>
            <span class="cs-value">≈ ${formatNumber(costRounded, lang)}</span>
            <span class="cs-sub">per API pricing over <DynNum stat="claude_days_elapsed" fallback="233" /> days</span>
          </div>
          <div class="cs-card cs-card-muted">
            <span class="cs-label">what we actually pay</span>
            <span class="cs-value">€100/mo</span>
            <span class="cs-sub">Claude Max subscription</span>
          </div>
          <div class="cs-card cs-card-accent">
            <span class="cs-label">compression factor</span>
            <span class="cs-value">~{compression}×</span>
            <span class="cs-sub">Max plan done right</span>
          </div>
        </div>
        <p class="cs-note">
          This number is not a bragging right — it's a <strong>discipline check</strong>.
          It exists because of CLAUDE.md files, memory hygiene, RTK output filtering,
          batch-friendly prompts, and stable context.
          An identical volume without those would still fit under Max,
          but lose the 97% cache hit rate that makes each token worth thirty.
        </p>
      </div>
    </section>

    <section class="cs-section alt reveal">
      <div class="container">
        <SectionHeading id="pipeline">How these numbers reach this page</SectionHeading>
        <pre class="pipeline-diagram"><code>{`  ┌─────────────┐        ┌──────────┐        ┌──────────┐        ┌───────────┐
  │  ~/.claude  │─jsonl─▶│ usage.db │─query─▶│ KV push  │─CF API─▶│ /api/stats│
  │  transcripts│        │ (sqlite) │        │ (CT 246) │         │  Worker   │
  └─────────────┘        └──────────┘        └──────────┘         └───────────┘
                                                                        │
                                                                        ▼
                                                             ┌────────────────────┐
                                                             │  this page (Astro) │
                                                             │  via <DynNum />    │
                                                             └────────────────────┘`}</code></pre>
        <p class="cs-paragraph">
          Scan-script : <a href="https://github.com/phuryn/claude-usage" target="_blank" rel="noopener">phuryn/claude-usage</a>.
          Push-script : <code>push-stats.sh</code>, versioned in the homelab repo, run daily at 18:00 by a systemd timer on Stéphane's workstation.
          Receiver : <code>/srv/kv-inbox/claude-stats.json</code> on CT 246 (Dagu) — moved from OpenFang at its June 2026 decommission.
          Forwarder : <code>/usr/local/bin/kv-push</code> (Dagu DAG, every 15 min) merges the file into the stats payload and posts to Cloudflare KV.
          Renderer : the <code>DynNum</code> component reads <code>/api/stats</code> at build time and bakes the number into the HTML; the site rebuilds every morning.
        </p>
        <p class="cs-note">
          Last run timestamp lives in <code>updated_at</code> of the KV blob.
          You can curl it yourself: <code>curl https://pixelium.win/api/stats</code>.
        </p>
      </div>
    </section>
  </main>
</Base>
