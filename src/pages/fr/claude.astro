---
import Base from '../../layouts/Base.astro';
import DynNum from '../../components/DynNum.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getBuildStats } from '../../lib/build-stats';
import { getLangFromUrl, formatNumber } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const s = await getBuildStats();
const n = (k: string, d: number): number => (Number.isFinite(Number(s[k])) ? Number(s[k]) : d);

// Everything below comes from the KV (homelab push-stats.sh → kv-push, keys claude_*).
// The literals are only the last-known snapshot (2026-10-14), used if the build
// cannot reach /api/stats — this page used to be written by hand and drifted for months.
const HEATMAP_FALLBACK = [
  16694, 12056,  9074,  8021,  5577,  3949,  1488,   524,
    584,   452,   241,  1657,  3182,  5765,  8344, 10204,
   9361, 10266, 10492, 11581,  7878, 10233, 13853, 14855
];
// The KV only holds scalars (StatsBagSchema), so the heatmap comes as "16801,12056,…".
const heatmapParsed = String(s.claude_heatmap_paris ?? '').split(',').map(Number);
const heatmapLocal: number[] = heatmapParsed.length === 24 && heatmapParsed.every(Number.isFinite)
  ? heatmapParsed : HEATMAP_FALLBACK;
const maxTurns = Math.max(...heatmapLocal);
const peakHour = heatmapLocal.indexOf(maxTurns);
const troughHour = heatmapLocal.indexOf(Math.min(...heatmapLocal));
const hh = (h: number) => String(h).padStart(2, '0');

const FOCUS_FALLBACK: [string, number][] = [
  ['Claude/homelab', 66.1], ['Claude/web', 12.4], ['Claude/HTB', 9.9],
  ['terre2/Claude', 5.5], ['Claude/veille', 3.2],
];
// Same reason: "project:pct|project:pct".
const focusParsed: [string, number][] = String(s.claude_focus ?? '').split('|')
  .map((e) => { const i = e.lastIndexOf(':'); return [e.slice(0, i), Number(e.slice(i + 1))] as [string, number]; })
  .filter(([p, v]) => p && Number.isFinite(v));
const focusTop: [string, number][] = focusParsed.length ? focusParsed : FOCUS_FALLBACK;
const focusOther = Math.max(0, Math.round((100 - focusTop.reduce((a, [, v]) => a + v, 0)) * 10) / 10);

// Productivity: Forgejo commits over the last 30 days, per hour of active time over the
// same 30 days (all repos, merges included — an order of magnitude, nothing finer).
const commitsPerHour = n('forgejo_commits_30d', 985) / Math.max(1, n('claude_active_hours_30d', 142));
const minutesPerCommit = 60 / commitsPerHour;

// Economics: API-priced estimate from claude-usage's own price table, against the €100/mo
// Max plan over the same period. EUR→USD taken at 1.16 (October 2026) — a ballpark ratio.
const costUsd = n('claude_cost_usd', 27612);
const daysElapsed = n('claude_days_elapsed', 233);
const paidUsd = (daysElapsed / 30.44) * 100 * 1.16;
const compression = Math.round(costUsd / paidUsd);
const FOCUS_LABELS: Record<string, string> = { 'Claude/web': 'Claude/web (ce site)', 'terre2/Claude': 'Claude (hub)' };
const costRounded = Math.round(costUsd / 100) * 100;
---

<Base
  title="Stats Claude — le grand livre du pair-programming — pixelium.win"
  description="Tous les chiffres derrière la symbiose : heures, sessions, cache hit, rythme horaire, focus projets. Rafraîchis depuis la base claude-usage locale."
>
  <main>
    <section class="cs-hero">
      <div class="container cs-hero-wrap">
        <p class="cs-eyebrow">∷ stats claude · le grand livre</p>
        <h1>À quoi ressemblent <span class="accent"><DynNum stat="claude_active_hours" fallback="1199" group /> heures</span></h1>
        <p class="cs-lede">
          Rien n'est arrondi vers le haut. Chaque chiffre vient de <code>~/.claude/usage.db</code> —
          les transcripts JSONL que Claude Code écrit sur la workstation de Stéphane,
          scannés par <a href="https://github.com/phuryn/claude-usage" target="_blank" rel="noopener">phuryn/claude-usage</a>,
          expédiés en SSH vers le homelab, puis poussés vers Cloudflare KV au prochain tick timer. Le forwarder a pris sa retraite avec OpenFang et a été rebranché via Dagu (CT 246) en juin 2026.
        </p>
      </div>
    </section>

    <section class="cs-section reveal">
      <div class="container">
        <SectionHeading id="volume">Volume</SectionHeading>
        <div class="cs-grid four">
          <div class="cs-card">
            <span class="cs-label">heures actives</span>
            <span class="cs-value"><DynNum stat="claude_active_hours" fallback="1199" group /></span>
            <span class="cs-sub">pauses de plus de 30 min exclues</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">durée des sessions</span>
            <span class="cs-value"><DynNum stat="claude_hours" fallback="13982" group /></span>
            <span class="cs-sub">somme des durées de session</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">sessions</span>
            <span class="cs-value"><DynNum stat="claude_sessions" fallback="1557" /></span>
            <span class="cs-sub">tous projets confondus</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">turns</span>
            <span class="cs-value"><DynNum stat="claude_turns" fallback="176331" group /></span>
            <span class="cs-sub">chaque échange user+assistant</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">tokens</span>
            <span class="cs-value"><DynNum stat="claude_tokens_billions" fallback="35.3" suffix="B" /></span>
            <span class="cs-sub">input + output + cache</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">cache hit</span>
            <span class="cs-value"><DynNum stat="claude_cache_hit" fallback="97" />%</span>
            <span class="cs-sub"><DynNum stat="claude_cache_read_billions" fallback="34.3B" suffix="B" /> de cache reads</span>
          </div>
        </div>

        <p class="cs-note">
          <strong>Ce que veut dire ce taux</strong> : sur 100 tokens que je lis,
          97 sortent du prompt cache plutôt que d'être re-traités from scratch.
          C'est le chiffre qui sépare <em>utiliser Claude</em> de <em>utiliser Claude bien</em>.
          Un taux aussi élevé est la signature d'un <code>CLAUDE.md</code> qui ne dérive pas,
          d'une mémoire bien structurée et de prompts batch-friendly.
        </p>
      </div>
    </section>

    <section class="cs-section alt reveal">
      <div class="container">
        <SectionHeading id="rhythm">Rythme</SectionHeading>
        <div class="cs-grid three">
          <div class="cs-card">
            <span class="cs-label">heures actives par jour</span>
            <span class="cs-value"><DynNum stat="claude_active_hours_per_day" fallback="6.1" /></span>
            <span class="cs-sub">temps actif mesuré · <DynNum stat="claude_active_days" fallback="197" /> jours actifs</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">plus longue session</span>
            <span class="cs-value"><DynNum stat="claude_longest_session_h" fallback="18h" suffix="h" /></span>
            <span class="cs-sub">temps actif, pauses de plus de 30 min exclues</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">taux de jours actifs</span>
            <span class="cs-value"><DynNum stat="claude_days_active_pct" fallback="84" />%</span>
            <span class="cs-sub"><DynNum stat="claude_active_days" fallback="197" /> / <DynNum stat="claude_days_elapsed" fallback="233" /> — presque tous les jours</span>
          </div>
        </div>

        <p class="cs-note">
          <strong>Deux façons de compter les heures.</strong> Le chiffre du haut est le temps actif
          mesuré : les turns de toutes les sessions, triés ensemble, dont on n'additionne que les
          écarts de 30 minutes au plus. Les sessions parallèles comptent une fois, une pause ne compte
          pas. La durée des sessions (<DynNum stat="claude_hours" fallback="13982" group /> h)
          additionne chaque session de son premier turn au dernier : une session reprise des jours plus
          tard compte tout l'intervalle, et les sessions parallèles s'additionnent. C'était le chiffre
          du haut jusqu'en octobre 2026.
        </p>

        <h3 class="cs-sub-heading">Activité horaire — heure locale (Paris)</h3>
        <p class="cs-paragraph">
          Turns par heure, cumulés sur <DynNum stat="claude_days_elapsed" fallback="233" /> jours.
          La forme est le portrait honnête de notre rythme de travail : l'après-midi et la nuit,
          avec un creux de sommeil le matin.
        </p>
        <div class="heatmap">
          {heatmapLocal.map((v, h) => {
            const pct = Math.round((v / maxTurns) * 100);
            const hour = String(h).padStart(2, '0');
            return (
              <div class="heatmap-col" title={`${hour}h — ${formatNumber(v, lang)} turns`}>
                <div class="heatmap-bar-wrap">
                  <div class="heatmap-bar" style={`height:${pct}%`}></div>
                </div>
                <span class="heatmap-hour">{hour}</span>
              </div>
            );
          })}
        </div>
        <p class="cs-legend">
          <span class="legend-dot"></span>survol une colonne pour voir le nombre exact ·
          pic à {hh(peakHour)}h, creux à {hh(troughHour)}h
        </p>
      </div>
    </section>

    <section class="cs-section reveal">
      <div class="container">
        <SectionHeading id="productivity">Productivité (approximatif)</SectionHeading>
        <p class="cs-paragraph">
          Ces ratios croisent <code>claude-usage</code>, <code>git log</code> et l'API Forgejo.
          Utile comme ordre de grandeur, pas de précision.
        </p>
        <div class="cs-grid three">
          <div class="cs-card">
            <span class="cs-label">commits / heure active</span>
            <span class="cs-value">~{formatNumber(Math.round(commitsPerHour), lang)}</span>
            <span class="cs-sub">tous les repos Forgejo, merges compris, 30 derniers jours</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">minutes / commit</span>
            <span class="cs-value">~{formatNumber(Math.round(minutesPerCommit), lang)}</span>
            <span class="cs-sub">inclut réflexion + test + fix</span>
          </div>
          <div class="cs-card">
            <span class="cs-label">issues fermées / semaine</span>
            <span class="cs-value">~8</span>
            <span class="cs-sub">Forgejo <code>infra/homelab</code>, 4 dernières semaines (octobre 2026)</span>
          </div>
        </div>
      </div>
    </section>

    <section class="cs-section alt reveal">
      <div class="container">
        <SectionHeading id="focus">Répartition par projet</SectionHeading>
        <p class="cs-paragraph">Où est passé le temps actif.</p>
        <div class="focus-bars">
          {[...focusTop.map(([p, v]) => [FOCUS_LABELS[p] ?? p, v] as [string, number]), ['autres', focusOther] as [string, number]].map(([label, v]) => (
            <div class="focus-row">
              <span class="focus-label">{label}</span>
              <div class="focus-track"><div class="focus-fill" style={`width:${v}%`}></div></div>
              <span class="focus-val">{v.toFixed(1)}%</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="cs-section reveal">
      <div class="container">
        <SectionHeading id="economics">L'économie</SectionHeading>
        <div class="cs-grid three">
          <div class="cs-card cs-card-muted">
            <span class="cs-label">équivalent pay-as-you-go</span>
            <span class="cs-value">≈ {formatNumber(costRounded, lang)} $</span>
            <span class="cs-sub">tarif API sur <DynNum stat="claude_days_elapsed" fallback="233" /> jours</span>
          </div>
          <div class="cs-card cs-card-muted">
            <span class="cs-label">ce qu'on paye vraiment</span>
            <span class="cs-value">100 €/mois</span>
            <span class="cs-sub">abonnement Claude Max</span>
          </div>
          <div class="cs-card cs-card-accent">
            <span class="cs-label">facteur compression</span>
            <span class="cs-value">~{compression}×</span>
            <span class="cs-sub">Max plan utilisé comme il faut</span>
          </div>
        </div>
        <p class="cs-note">
          Ce chiffre n'est pas une fierté — c'est un <strong>test de discipline</strong>.
          Il existe grâce aux fichiers CLAUDE.md, à l'hygiène mémoire, au filtrage de sortie RTK,
          aux prompts batch-friendly, au contexte stable. Sans ça, le même volume tiendrait
          encore dans le Max, mais on perdrait le 97% cache hit qui fait que chaque token vaut trente.
        </p>
      </div>
    </section>

    <section class="cs-section alt reveal">
      <div class="container">
        <SectionHeading id="pipeline">Comment ces chiffres arrivent ici</SectionHeading>
        <pre class="pipeline-diagram"><code>{`  ┌─────────────┐        ┌──────────┐        ┌──────────┐        ┌───────────┐
  │  ~/.claude  │─jsonl─▶│ usage.db │─query─▶│ KV push  │─CF API─▶│ /api/stats│
  │  transcripts│        │ (sqlite) │        │ (CT 246) │         │  Worker   │
  └─────────────┘        └──────────┘        └──────────┘         └───────────┘
                                                                        │
                                                                        ▼
                                                             ┌────────────────────┐
                                                             │ cette page (Astro) │
                                                             │ via <DynNum />     │
                                                             └────────────────────┘`}</code></pre>
        <p class="cs-paragraph">
          Scan-script : <a href="https://github.com/phuryn/claude-usage" target="_blank" rel="noopener">phuryn/claude-usage</a>.
          Push-script : <code>push-stats.sh</code>, versionné dans le dépôt homelab, lancé chaque jour à 18h par un timer systemd sur la workstation de Stéphane.
          Récepteur : <code>/srv/kv-inbox/claude-stats.json</code> sur CT 246 (Dagu) — déménagé d'OpenFang à son décommissionnement (juin 2026).
          Forwarder : <code>/usr/local/bin/kv-push</code> (DAG Dagu, toutes les 15 min) fusionne le fichier dans le payload stats et poste vers Cloudflare KV.
          Rendu : le composant <code>DynNum</code> lit <code>/api/stats</code> au build et inscrit le chiffre dans le HTML ; le site est reconstruit chaque matin.
        </p>
        <p class="cs-note">
          Le timestamp du dernier run est dans le champ <code>updated_at</code> du blob KV.
          Vous pouvez le curl vous-même : <code>curl https://pixelium.win/api/stats</code>.
        </p>
      </div>
    </section>
  </main>
</Base>

<style>
  .cs-hero { padding: 4rem 0 2.5rem; }
  .cs-hero-wrap > p { max-width: 50rem; }

  .cs-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    margin-bottom: 0.75rem;
    opacity: 0.85;
  }

  .cs-hero h1 {
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1.75rem;
  }

  .accent { color: var(--color-accent); }

  .cs-lede {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .cs-lede code, .cs-note code, .cs-paragraph code {
    color: var(--color-accent);
    background: rgba(56, 189, 248, 0.08);
    padding: 0.08rem 0.35rem;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .cs-lede a, .cs-note a, .cs-paragraph a { color: var(--color-accent); }

  .cs-section { padding: 3rem 0; }

  .cs-section.alt {
    background: linear-gradient(180deg, rgba(56, 189, 248, 0.02), transparent);
    border-top: 1px solid rgba(56, 189, 248, 0.08);
    border-bottom: 1px solid rgba(56, 189, 248, 0.08);
  }

  .cs-grid {
    display: grid;
    gap: 0.75rem;
    margin: 0;
  }

  .cs-grid.four { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 640px) { .cs-grid.four { grid-template-columns: repeat(2, 1fr); } }
  .cs-grid.three { grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }

  .cs-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 1.25rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: linear-gradient(180deg, rgba(56, 189, 248, 0.04), transparent);
    text-align: center;
  }

  .cs-card-muted { background: rgba(11, 17, 32, 0.5); }

  .cs-card-accent {
    border-color: rgba(56, 189, 248, 0.4);
    background: linear-gradient(180deg, rgba(56, 189, 248, 0.1), rgba(56, 189, 248, 0.02));
  }

  .cs-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .cs-value {
    font-family: var(--font-mono);
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .cs-sub {
    font-size: 0.72rem;
    color: var(--color-text-muted);
    opacity: 0.75;
    line-height: 1.4;
  }

  .cs-note {
    max-width: 50rem;
    margin: 1.5rem 0 0;
    padding: 1rem 1.25rem;
    border-left: 2px solid rgba(56, 189, 248, 0.4);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    background: rgba(56, 189, 248, 0.03);
  }

  .cs-note strong { color: var(--color-text); font-weight: 600; }
  .cs-note em { color: var(--color-text); }

  .cs-paragraph {
    max-width: 50rem;
    margin: 0 0 1.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .cs-paragraph strong { color: var(--color-text); font-weight: 600; }

  .cs-sub-heading {
    margin: 2.5rem 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .heatmap {
    margin: 1rem 0;
    display: grid;
    grid-template-columns: repeat(24, 1fr);
    gap: 2px;
    height: 10rem;
    align-items: end;
    padding: 0.75rem;
    border: 1px solid rgba(56, 189, 248, 0.15);
    border-radius: 6px;
    background: rgba(11, 17, 32, 0.4);
  }

  .heatmap-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    gap: 0.25rem;
    cursor: help;
  }

  .heatmap-bar-wrap {
    width: 100%;
    height: calc(100% - 1rem);
    display: flex;
    align-items: flex-end;
  }

  .heatmap-bar {
    width: 100%;
    background: linear-gradient(180deg, var(--color-accent), rgba(56, 189, 248, 0.3));
    border-radius: 2px 2px 0 0;
    transition: opacity 0.2s;
    min-height: 2px;
  }

  .heatmap-col:hover .heatmap-bar { opacity: 0.7; }

  .heatmap-hour {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  .cs-legend {
    margin: 0.5rem 0 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    opacity: 0.65;
  }

  .legend-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--color-accent);
    border-radius: 2px;
    margin-right: 0.5rem;
    vertical-align: middle;
    opacity: 0.7;
  }

  .focus-bars {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .focus-row {
    display: grid;
    grid-template-columns: 12rem 1fr 3.5rem;
    align-items: center;
    gap: 0.75rem;
  }

  .focus-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text);
  }

  .focus-track {
    height: 0.6rem;
    background: var(--color-surface);
    border-radius: 3px;
    overflow: hidden;
  }

  .focus-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--color-accent), rgba(56, 189, 248, 0.5));
    border-radius: 3px;
  }

  .focus-val {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-accent);
    text-align: right;
  }

  .pipeline-diagram {
    margin: 0 0 1.5rem;
    background: rgba(11, 17, 32, 0.6);
    border: 1px solid rgba(56, 189, 248, 0.15);
    border-radius: 6px;
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.72rem;
    line-height: 1.4;
  }

  .pipeline-diagram code {
    font-family: var(--font-mono);
    color: var(--color-text);
    background: none;
    padding: 0;
    white-space: pre;
  }

  @media (max-width: 640px) {
    .focus-row { grid-template-columns: 8rem 1fr 3rem; }
    .focus-label { font-size: 0.75rem; }
  }
</style>
