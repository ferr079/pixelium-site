---
import Base from '../../layouts/Base.astro';
import '../../styles/status.css';
import PageHero from '../../components/PageHero.astro';
import { SERVICE_INFO } from '../../data/service-info';
import { getBuildStats } from '../../lib/build-stats';

const svcInfoJson = JSON.stringify(SERVICE_INFO);
const stats = await getBuildStats();
---

<Base title="Statut — pixelium.win" description={`Statut live de l'infrastructure : ${stats.services_total} services, ${stats.proxmox_nodes} nœuds Proxmox, monitoring tri-state (up · on-demand · down). Données poussées depuis le homelab par Dagu toutes les 15 minutes.`}>
  <main class="status-page">
    <PageHero prompt="$ ping --all" title="Statut">
      Dashboard infrastructure live. Données poussées par Dagu toutes les 15 minutes — zéro port exposé.
    </PageHero>

    <!-- Bandeau alerte données périmées -->
    <div id="stale-banner" class="stale-banner" style="display:none;">
      <span class="stale-icon">&#9888;</span>
      <span id="stale-text">Homelab injoignable — les données affichées peuvent être obsolètes.</span>
    </div>

    <!-- Résumé -->
    <section class="status-summary reveal">
      <div class="container">
        <div class="summary-grid">
          <div class="summary-card">
            <span class="summary-dot" id="global-dot"></span>
            <span class="summary-value" id="summary-up">--</span>
            <span class="summary-sep">/</span>
            <span class="summary-value summary-total" id="summary-total">--</span>
            <span class="summary-label">services UP</span>
          </div>
          <div class="summary-card">
            <span class="summary-value" id="summary-uptime">--</span>
            <span class="summary-label">disponibilité</span>
          </div>
          <div class="summary-card">
            <span class="summary-value" id="summary-nodes">--</span>
            <span class="summary-label">nœuds PVE</span>
          </div>
          <div class="summary-card">
            <span class="summary-value summary-timestamp" id="summary-updated">en attente de synchronisation</span>
            <span class="summary-label">dernière vérification</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Historique uptime 30j -->
    <section class="layer reveal" data-lang="fr">
      <div class="container">
        <div id="uptime-loading" class="uptime-placeholder">
          <div class="uptime-skeleton"></div>
          <p class="uptime-wait">Chargement de l'historique...</p>
        </div>
        <div id="uptime-timeline" style="display:none;">
          <div class="uptime-header">
            <span class="uptime-avg" id="uptime-avg">--</span>
            <span class="uptime-period" id="uptime-period"></span>
          </div>
          <div class="uptime-bars" id="uptime-bars"></div>
          <div class="uptime-labels">
            <span>il y a 30j</span>
            <span>aujourd'hui</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section class="layer reveal">
      <div class="container">
        <div id="services-loading" class="status-loading">
          <div class="skeleton-grid">
            {Array.from({ length: 12 }).map(() => (
              <div class="skeleton-card"></div>
            ))}
          </div>
          <p class="status-waiting">En attente des premières données du homelab...</p>
        </div>
        <div id="services-grid" class="services-container" style="display:none;"></div>
      </div>
    </section>

    <!-- On-demand (pve3 Wake-on-LAN) -->
    <section class="layer reveal" id="ondemand-section" style="display:none;">
      <div class="container">
        <div class="ondemand-head">
          <h3 class="ondemand-title">On-demand · pve3 <span class="ondemand-tag">Wake-on-LAN</span></h3>
          <span class="ondemand-state" id="ondemand-state">—</span>
        </div>
        <div class="service-grid" id="ondemand-grid"></div>
        <p class="ondemand-note" id="ondemand-note"></p>
      </div>
    </section>

    <!-- Nœuds -->
    <section class="layer reveal">
      <div class="container">
        <div id="nodes-loading" class="status-loading">
          <div class="skeleton-grid skeleton-nodes">
            {Array.from({ length: 3 }).map(() => (
              <div class="skeleton-card skeleton-node"></div>
            ))}
          </div>
        </div>
        <div id="nodes-grid" class="nodes-grid" style="display:none;"></div>
      </div>
    </section>

    <!-- Note de bas de page -->
    <section class="status-footer reveal">
      <div class="container">
        <p class="status-note">
          Données poussées depuis le homelab par <strong>Dagu</strong> (orchestrateur de workflows, CT 246) via l'API Cloudflare KV.<br/>
          Zéro port exposé — push HTTPS sortant uniquement.
        </p>
      </div>
    </section>

    <!-- Popover info service (clic sur une carte) -->
    <div id="svc-popover" class="svc-popover" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="svc-pop-title">
      <div class="svc-pop-box" role="document">
        <button type="button" class="svc-pop-close" id="svc-pop-close" aria-label="Fermer">&times;</button>
        <h3 class="svc-pop-title" id="svc-pop-title"></h3>
        <p class="svc-pop-what" id="svc-pop-what"></p>
        <div class="svc-pop-why">
          <span class="svc-pop-why-label" id="svc-pop-why-label"></span>
          <p class="svc-pop-why-text" id="svc-pop-why-text"></p>
        </div>
      </div>
    </div>
    <script type="application/json" id="svc-info" set:html={svcInfoJson}></script>
  </main>
</Base>

<script>
  // Client de /status — implémentation PARTAGÉE EN/FR : ../../scripts/status-page
  // Ces ~340 lignes étaient forkées entre les deux locales ; un correctif métier
  // oublié d'un côté produisait un bug visible dans une seule langue. La langue
  // est lue sur <html lang>, voir l'en-tête du module.
  import '../../scripts/status-page';
</script>


<style is:global>
  @keyframes pulse-dot { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
  @keyframes skeleton-pulse { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.8; } }

  /* Uptime bars (created by JS) */
  .uptime-bars { display: flex; gap: 3px; height: 2.5rem; align-items: stretch; }
  .ubar { flex: 1; border-radius: var(--radius-xs); cursor: pointer; transition: transform 0.15s, opacity 0.15s; min-width: 0; }
  .ubar:hover { transform: scaleY(1.15); opacity: 0.85; }
  .ubar-perfect { background: var(--color-ok); }
  .ubar-good { background: #4ade80; }
  .ubar-degraded { background: #fbbf24; }
  .ubar-bad { background: #f87171; }
  .ubar-nodata { background: var(--color-border); opacity: 0.4; }

  .summary-dot.healthy { background: var(--color-ok); box-shadow: 0 0 8px rgb(var(--ok-rgb) / 0.6); animation: pulse-dot 2s ease-in-out infinite; }
  .summary-dot.degraded { background: var(--color-warn); box-shadow: 0 0 8px rgb(var(--warn-rgb) / 0.6); animation: pulse-dot 2s ease-in-out infinite; }

  .service-category { margin-bottom: 2rem; }
  .category-title { font-family: var(--font-mono); font-size: var(--text-base); color: var(--color-accent); margin-bottom: 0.75rem; letter-spacing: 0.05em; }
  .service-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.5rem; }
  .service-card { display: flex; align-items: center; gap: 0.6rem; padding: 0.6rem 0.9rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); transition: border-color 0.2s; }
  .service-card:hover { border-color: var(--color-accent); }
  .svc-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .svc-dot.up { background: var(--color-ok); }
  .svc-dot.down { background: var(--color-down); box-shadow: 0 0 6px rgb(var(--down-rgb) / 0.5); }
  /* services on-demand (pve3 WOL) — accent ciel, pas rouge : endormis par conception, pas cassés */
  .svc-dot.on-demand { background: var(--color-accent); box-shadow: 0 0 6px rgb(var(--accent-rgb) / 0.5); }
  .svc-ondemand { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--color-accent); letter-spacing: 0.05em; }
  .svc-name { font-family: var(--font-mono); font-size: var(--text-md); color: var(--color-text); flex: 1; }

  /* section on-demand (pve3 WOL) */
  .ondemand-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 0.9rem; flex-wrap: wrap; }
  .ondemand-title { font-family: var(--font-mono); font-size: var(--text-base); color: var(--color-accent); letter-spacing: 0.05em; margin: 0; }
  .ondemand-tag { color: var(--color-text-muted); font-weight: 400; font-size: var(--text-sm); }
  .ondemand-state { font-family: var(--font-mono); font-size: var(--text-sm); letter-spacing: 0.04em; }
  .ondemand-state.awake { color: var(--color-ok); }
  .ondemand-state.asleep { color: var(--color-accent); }
  .ondemand-note { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--color-text-muted); margin-top: 0.75rem; opacity: 0.8; }
  .svc-latency { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text-muted); }

  .nodes-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem; }
  .node-card { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1rem 1.1rem; transition: border-color 0.2s; display: flex; flex-direction: column; min-height: 7.5rem; }
  .node-card:hover { border-color: var(--color-accent); }
  .node-name { font-family: var(--font-mono); font-size: var(--text-lg); font-weight: 700; color: var(--color-text); margin: 0 0 0.85rem; }
  .node-metric { display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.45rem; }
  .metric-label { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--color-text-muted); width: 2.3rem; }
  .bar { flex: 1; height: 6px; background: var(--color-border); border-radius: var(--radius-xs); overflow: hidden; }
  .bar-fill { height: 100%; border-radius: var(--radius-xs); transition: width 0.8s ease-out; }
  .metric-value { font-family: var(--font-mono); font-size: var(--text-xs); color: var(--color-text); width: 2.75rem; text-align: right; }
  .node-uptime { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--color-text-muted); margin-top: auto; padding-top: 0.5rem; }
  .node-offline { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--color-text-muted); font-style: italic; }

  /* on-demand nodes (pve3 WOL) — sky accent, pas rouge */
  .node-ondemand {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-accent);
    background: rgb(var(--accent-rgb) / 0.08);
    border: 1px solid rgb(var(--accent-rgb) / 0.25);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-xs);
    letter-spacing: 0.04em;
    width: fit-content;
  }
  .node-card.node-on-demand { border-style: dashed; border-color: rgb(var(--accent-rgb) / 0.25); }
  .node-sub { font-family: var(--font-mono); font-size: var(--text-2xs); color: var(--color-text-muted); margin-top: 0.5rem; opacity: 0.75; }

  @media (max-width: 700px) {
    .nodes-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .nodes-grid { grid-template-columns: 1fr; }
    .service-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .summary-dot.healthy, .summary-dot.degraded { animation: none; }
    .skeleton-card { animation: none; opacity: 0.6; }
    .bar-fill { transition: none; }
  }

  /* Clickable service cards → info popover */
  .service-card.has-info { cursor: pointer; }
  .service-card.has-info:hover { border-color: var(--color-accent); box-shadow: 0 0 12px rgb(var(--accent-rgb) / 0.12); }
  .service-card.has-info:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .service-card.has-info .svc-name { text-decoration: underline dotted rgb(var(--accent-rgb) / 0.45); text-underline-offset: 3px; }

  .svc-popover { position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center; padding: 1.5rem; background: rgba(8,12,22,0.72); backdrop-filter: blur(3px); }
  .svc-pop-box { position: relative; max-width: 30rem; width: 100%; background: var(--color-surface); border: 1px solid var(--color-accent); border-radius: var(--radius-xl); padding: 1.75rem 1.75rem 1.5rem; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
  .svc-pop-close { position: absolute; top: 0.5rem; right: 0.85rem; background: none; border: none; color: var(--color-text-muted); font-size: var(--text-5xl); line-height: 1; cursor: pointer; transition: color 0.2s; }
  .svc-pop-close:hover { color: var(--color-accent); }
  .svc-pop-title { font-family: var(--font-mono); font-size: var(--text-2xl); color: var(--color-accent); margin: 0 0 0.75rem; }
  .svc-pop-what { color: var(--color-text); font-size: var(--text-lg); line-height: 1.6; margin: 0 0 1rem; }
  .svc-pop-why { border-top: 1px solid var(--color-border); padding-top: 0.85rem; }
  .svc-pop-why-label { display: block; font-family: var(--font-mono); font-size: var(--text-2xs); text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent); margin-bottom: 0.35rem; }
  .svc-pop-why-text { color: var(--color-text-muted); font-size: var(--text-base); line-height: 1.6; margin: 0; }
</style>
